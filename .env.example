# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave publicable (sb_publishable_...) o la antigua "anon key". Es pública por diseño: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- IA (opcional; la app funciona sin ella) ---
# none | anthropic | openai  ("openai" vale para cualquier API compatible con AI_BASE_URL)
AI_PROVIDER=none
# Vacío = modelo por defecto (claude-haiku-5-5 / gpt-5-mini). Obligatorio con AI_BASE_URL.
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ej. Gemini gratis: https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=
# Tope de tokens al día (0 = sin tope)
AI_DAILY_TOKEN_LIMIT=300000
