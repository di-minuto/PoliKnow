# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave publicable (sb_publishable_...) o la antigua "anon key". Es pública por diseño: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- IA (opcional; la app funciona sin ella) ---
# none | anthropic | openai   (los proveedores reales llegan en la Fase 9)
AI_PROVIDER=none
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
